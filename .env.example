# ============================================================
# IRmAPI 配置示例
# 复制为 .env 后按需修改。所有项都有默认值，看不懂的不要乱填。
# ============================================================

# ---- 服务基础 ----
# 监听地址与端口
HOST=0.0.0.0
PORT=5005

# 服务自身的授权码（可选，多账号/防乱用）。
# 客户端请求时把 Authorization 填成这里任意一个值，
# 服务端就会使用下方服务端凭据池里的账号。
AUTHORIZATION=
# 控制台口令（可选）。设置后访问 /api/status、/api/playground 等
# 接口时必须在请求头带上 X-Console-Key: <口令>，控制台页面会自动弹口令框。
# 留空则控制台完全公开（仅本机访问时问题不大）。
CONSOLE_KEY=

# ============================================================
# 通道一：豆包网页版（免 Key，类似 Chat2API 用 ChatGPT accessToken）
# ============================================================
# 【怎么拿完整 Cookie】
#   1) 用电脑浏览器登录 https://www.doubao.com/chat/
#   2) 按 F12 打开开发者工具 -> 切到「网络(Network)」面板
#   3) 在豆包输入框随便发一句话
#   4) 在请求列表里找到 completion 那条请求，右键 -> 复制 -> 复制为 cURL (bash)
#   5) 从 cURL 命令里找到 --cookie '...' 一段，把引号里的整串 Cookie 粘到下面
#      推荐带上 sessionid、ttwid、uid_tt 等完整字段，稳定性最好
# 支持多账号轮询：继续填 DOUBAO_COOKIE_2、DOUBAO_COOKIE_3 ...
DOUBAO_COOKIE_1=

# 简易模式：只有 sessionid 也可以（从 F12 -> Application -> Cookies 复制 sessionid）
# 但豆包可能要求更多 cookie 字段，推荐优先使用上面的完整 Cookie。
# DOUBAO_SESSIONIDS=

# 可选：签名增强。从浏览器请求 URL 里复制真实的 msToken 和 a_bogus 填进来。
# 用「假签名」被豆包风控（返回 400/403）时，填上真实值通常能解决。
DOUBAO_MS_TOKEN=
DOUBAO_A_BOGUS=

# 可选：覆盖设备指纹（一般不需要动）
# DOUBAO_DEVICE_ID=
# DOUBAO_WEB_ID=

# 请求失败自动换下一个账号重试的次数
DOUBAO_RETRY=3

# 是否在每次对话结束后自动删除会话记录（不留痕，默认开）
DOUBAO_CLEAN_CONVERSATION=true

# ============================================================
# 通道二：豆包官方火山方舟（稳定、有免费额度，推荐正式用）
# ============================================================
# 在 https://console.volcengine.com/ark 开通模型并创建 API Key
# （lite 类模型每天有免费 token 额度）
ARK_API_KEY=
# 默认模型 ID（以方舟控制台「模型列表」为准，会随版本变化）
ARK_MODEL=doubao-seed-1-6-lite-251015

# ============================================================
# 通道三：通用 OpenAI 兼容上游（可接 DeepSeek/Kimi/硅基流动等任意服务）
# ============================================================
# base_url 需带版本路径，如 https://api.deepseek.com/v1 或 http://x.x.x.x:11434/v1
COMPAT_BASE_URL=
COMPAT_API_KEY=
COMPAT_MODEL=

# ============================================================
# 通道四：DeepSeek（网页版免 Key / 官方 API 兜底）
# ============================================================
# 方式一（免 Key，推荐）：登录 chat.deepseek.com，F12 → 网络 → 发一句话，
# 找 chat/completions 请求 → 复制为 cURL → 取 --cookie '...' 整串填下面。
# 网关会自动提取其中的 token；支持多账号 DEEPSEEK_COOKIE_2 ...
DEEPSEEK_COOKIE_1=
# 方式二：直接填网页版 token（登录后任意请求头 Authorization: Bearer 后面那串）
# DEEPSEEK_TOKEN=
# 方式三（官方，按量计费）：platform.deepseek.com 创建 Key（网页版不可用时的稳定兜底）
# DEEPSEEK_API_KEY=

# ============================================================
# 通道五：通义千问 Qwen（阿里云百炼，官方免费额度）
# ============================================================
# 在 https://bailian.console.aliyun.com 开通百炼并创建 API-KEY（新用户有免费 token）
QWEN_API_KEY=
# 默认走百炼 OpenAI 兼容地址，一般不用改
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================================
# 通道五补充：通义千问网页版（免 Key，可软件内一键登录自动抓取）
# ============================================================
# 登录 https://tongyi.aliyun.com 后，F12 → 应用/Application → Cookies，
# 把带 tongyi_sso_ticket 的完整 Cookie 串填这里（网关自动提取票据）。
# 桌面版 / APK 可在凭据页点「一键登录」自动抓取。支持多账号 QWEN_COOKIE_2 ...
# QWEN_COOKIE_1=
